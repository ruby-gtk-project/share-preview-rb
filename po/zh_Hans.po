msgid "Share Preview"
msgstr "分享预览"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" 为空！"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "找到了 \"{name}\"。"

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr "无法找到标题的元数据！将回退到文档标题。"

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "无法找到文档标题！将回退到网站URL。"

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr "在页面中添加一个 \"{tag}\" 标签以控制内容。"

