msgid "Unable to find any valid card type."
msgstr "未能找到任何有效的卡片类型。"

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr "未找到 \"{name}\"。请考虑添加 \"{name}\" 的元数据属性。"

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "找到了类型为 \"{name}\" 的卡片。"

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "未能找到有效的标题或描述。"

