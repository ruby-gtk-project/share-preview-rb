#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "Náhľad zdieľaní"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" je prázdne!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "Nájdené \"{name}\"."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr "Metaúdaje neboli nájdené! Namiesto toho bude použitý názov dokumentu."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr ""
"Názov dokumentu nebol nájdený! Namiesto toho bude použitá adresa webovej "
"stránky."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr ""
"Pridajte štítok \"{tag}\" na stránku, aby ste mali kontrolu nad obsahom."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "Popis by mal obsahovať minimálne \"{count}\" znakov."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Platný typ karty nebol nájdený."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr "Nemožno nájsť \"{name}\". Skúste vložiť metaúdaj \"{name}\"."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "Nájdené karty typu \"{name}\"."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Platný názov ani popis nebol nájdený."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "Vhodný obrázok sa nenachádza v metaúdajoch."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr "Vhodný obrázok sa nenachádza v metaúdajoch, ani v tele dokumentu."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr ""
"Vhodný obrázok sa nenachádza v metaúdajoch. Namiesto toho bude použitá ikona."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"Vhodný obrázok sa nenachádza v metaúdajoch. Namiesto toho bude použitá karta "
"\"{name}\" s ikonou."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "Pre obrázok \"{url}\" existuje odkaz na webstránku."

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "Obrázok \"{url}\" spĺňa požiadavky."

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "Obrázok \"{url}\" nespĺňa požiadavky. Dôvod: {info}."

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "Obrázok \"{url}\" spracovaný."

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "Nebolo možné vytvoriť miniatúru pre \"{url}\". Dôvod: {info}."

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
