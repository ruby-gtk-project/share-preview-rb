#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "Поділитися"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" є порожнім!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "Знайдено \"{name}\"."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr ""
"Не вдалося знайти метадані для заголовку! Повернення до заголовку документа."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "Не вдалося знайти заголовок документу! Повернення до URL-адреси сайту."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr "Додайте тег \"{tag}\" до сторінки, щоб мати змогу контролювати вміст."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "Опис має містити принаймні \"{count}\" символів."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Не вдалося знайти жодного дійсного типу картки."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr ""
"Не вдалося знайти \"{name}\". Розгляньте надання мета-властивості \"{name}\"."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "Знайдено картку типу \"{name}\"."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Не вдалося знайти жодного дійсного заголовку чи опису."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "Не вдалося знайти дійсного зображення в метаданих."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr "Не вдалося знайти дійсного зображення в метаданих чи тілі документу."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr ""
"Не вдалося знайти дійсного зображення в метаданих, буде створено піктограму."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"Не вдалося знайти дійсне зображення в метаданих, буде створено картку "
"\"{name}\" з піктограмою."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "Зображення \"{url}\" визначається відносною URL-адресою."

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "Зображення \"{url}\" відповідає вимогам."

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "Зображення \"{url}\" не відповідає вимогам: {info}."

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "Зображення \"{url}\" оброблено успішно."

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "Не вдалося створити мініатюру \"{url}\": {info}."

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
msgstr ""
"Не вдалося знайти достатньо даних для створення картки для цієї соціальної "
"мережі."

#: lib/card_box.rb:40
