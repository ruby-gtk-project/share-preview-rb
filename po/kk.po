msgid "Share Preview"
msgstr "Share Preview"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" бос!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "\"{name}\" табылды."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr "Атау үшін метадеректер табылмады!. Құжат атауына қайта оралу."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "Құжат атауы табылмады!. Сайт адресіне қайта оралу."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr "Мазмұнды басқару үшін бетке \"{tag}\" тегін қосыңыз."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "Сипаттама кем дегенде \"{count}\" таңбадан тұруы керек."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Жарамды карта түрі табылмады."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr "\"{name}\" табылмады. \"{name}\" мета қасиетін көрсетіп көріңіз."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "\"{name}\" түріндегі карта табылды."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Жарамды тақырып немесе сипаттама табылмады."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "Метадеректерден жарамды сурет табылмады."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr ""
"Метадеректерден немесе құжаттың негізгі бөлігінен жарамды сурет табылмады."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr "Метадеректерден жарамды сурет табылмады, таңбаша көрсетіледі."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"Метадеректерден жарамды сурет табылмады, таңбашасы бар \"{name}\" картасы "
"көрсетіледі."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "\"{url}\" суреті салыстырмалы url арқылы анықталған."

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "\"{url}\" суреті талаптарға сәйкес келеді."

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "\"{url}\" суреті талаптарға сәйкес келмеді: {info}."

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "\"{url}\" суреті сәтті өңделді."

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "\"{url}\" үшін нобай жасау сәтсіз аяқталды: {info}."

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
msgstr "Бұл әлеуметтік желі үшін карта жасауға жеткілікті дерек табылмады."

#: lib/card_box.rb:40
msgid "Twitter: No card found."
msgstr "Twitter: Карта табылмады."

#: lib/card_box.rb:112
msgid "Card Error"
msgstr "Карта қатесі"

#: lib/data.rb:63
#, python-brace-format
msgid "No occurrences found for \"{name}\"!"
msgstr "\"{name}\" үшін сәйкестік табылмады!"

#: lib/data.rb:71
#, python-brace-format
msgid "Found a valid occurrence for \"{name}\" with value \"{value}\"."
msgstr "\"{name}\" үшін \"{value}\" мәні бар жарамды сәйкестік табылды."

