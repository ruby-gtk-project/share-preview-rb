#: lib/image.rb:59
#, python-brace-format
msgid "Image is too heavy ({actual}), max size is {max}"
msgstr "படம் மிகவும் கனமானது ({actual}), அதிகபட்ச அளவு {max}"

#: lib/image.rb:66
