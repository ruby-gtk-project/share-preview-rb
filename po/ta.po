#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "முன்னோட்டத்தைப் பகிரவும்"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" காலியாக உள்ளது!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "\"{name}\" கிடைத்தது."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr ""
"தலைப்புக்கு ஒரு மெட்டாடேட்டாவைக் கண்டுபிடிக்க முடியவில்லை! ஆவண தலைப்புக்கு மீண்டும் "
"விழுகிறது."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "ஆவண தலைப்பைக் கண்டுபிடிக்க முடியவில்லை! தள முகவரி க்கு மீண்டும் விழுகிறது."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr ""
"உள்ளடக்கத்தின் மீது கட்டுப்பாட்டைக் கொண்டுவர பக்கத்தில் \"{tag}\" குறிச்சொல்லைச் சேர்க்கவும்."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "விளக்கம் குறைந்தபட்சம் \"{count}\" எழுத்துக்கள் நீளமாக இருக்க வேண்டும்."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "எந்த செல்லுபடியாகும் அட்டை வகையையும் கண்டுபிடிக்க முடியவில்லை."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr ""
"\"{name}\" ஐ கண்டுபிடிக்க முடியவில்லை. \"{name}\" மேவு சொத்தை வழங்குவதைக் "
"கவனியுங்கள்."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "\"{name}\" வகையின் அட்டை."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "எந்தவொரு சரியான தலைப்பு அல்லது விளக்கத்தையும் கண்டுபிடிக்க முடியவில்லை."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "மெட்டாடேட்டாவில் செல்லுபடியாகும் படத்தைக் கண்டுபிடிக்க முடியவில்லை."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr ""
"மேனிலை தரவு அல்லது ஆவண உடலில் செல்லுபடியாகும் படத்தைக் கண்டுபிடிக்க முடியவில்லை."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr ""
"மெட்டாடேட்டாவில் செல்லுபடியாகும் படத்தைக் கண்டுபிடிக்க முடியவில்லை, ஒரு ஐகானை வழங்கும்."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"மெட்டாடேட்டாவில் செல்லுபடியாகும் படத்தைக் கண்டுபிடிக்க முடியவில்லை, ஐகானுடன் \"{name}\" "
"கார்டை வழங்கும்."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "படம் \"{url}\" ஒரு தொடர்புடைய முகவரி உடன் வரையறுக்கப்படுகிறது."

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "படம் \"{url}\" தேவைகளை நிறைவு செய்தது."

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "படம் \"{url}\" தேவைகளை நிறைவு செய்யவில்லை: {info}."

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "படம் \"{url}\" வெற்றிகரமாக செயலாக்கப்பட்டது."

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "\"{url}\": {info} என்ற சிறுபடத்தில் தோல்வியுற்றது."

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
msgstr ""
"இந்த சமூக ஊடகத்திற்கான அட்டையை உருவாக்க போதுமான தரவைக் கண்டுபிடிக்க முடியவில்லை."

#: lib/card_box.rb:40
msgid "Twitter: No card found."
msgstr "ட்விட்டர்: அட்டை எதுவும் கிடைக்கவில்லை."

#: lib/card_box.rb:112
msgid "Card Error"
msgstr "அட்டை பிழை"

#: lib/data.rb:63
#, python-brace-format
msgid "No occurrences found for \"{name}\"!"
msgstr "\"{name}\" க்கு எந்த நிகழ்வுகளும் கிடைக்கவில்லை!"

#: lib/data.rb:71
#, python-brace-format
msgid "Found a valid occurrence for \"{name}\" with value \"{value}\"."
msgstr "\"{name}\" மதிப்புக்கு \"{value}\" க்கு செல்லுபடியாகும் நிகழ்வைக் கண்டறிந்தது."

