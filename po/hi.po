#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "Share Preview"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" खाली है!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "\"{name}\" मिला।"

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr "शीर्षक के लिए मेटाडेटा ढूंढने में असमर्थ! दस्तावेज़ शीर्षक पर वापस आते हैं।"

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "दस्तावेज़ का शीर्षक ढूंढने में असमर्थ! साइट URL पर वापस आते हैं।"

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr "सामग्री पर नियंत्रण पाने के लिए पृष्ठ पर एक \"{tag}\" टैग जोड़ें।"

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "विवरण कम से कम \"{count}\" अक्षर लंबा होना चाहिए।"

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "कोई वैध कार्ड प्रकार ढूंढने में असमर्थ।"

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr "\"{name}\" ढूंढने में असमर्थ। \"{name}\" मेटा प्रॉपर्टी प्रदान करने पर विचार करें।"

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "\"{name}\" प्रकार का कार्ड मिला।"

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "कोई वैध शीर्षक या विवरण ढूंढने में असमर्थ।"

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "मेटाडेटा में मान्य छवि ढूंढने में असमर्थ।"

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr "मेटाडेटा या दस्तावेज़ के मुख्य भाग में कोई मान्य छवि ढूंढने में असमर्थ।"

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr "मेटाडेटा में मान्य छवि ढूंढने में असमर्थ, एक आइकन प्रस्तुत करेगा।"

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"मेटाडेटा में एक वैध छवि ढूंढने में असमर्थ, आइकन के साथ एक \"{name}\" कार्ड प्रस्तुत करेगा।"

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "छवि \"{url}\" को एक सापेक्ष URL से परिभाषित किया गया है।"

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "छवि \"{url}\" आवश्यकताओं को पूरा करती है।"

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "छवि \"{url}\" आवश्यकताओं को पूरा नहीं करती: {info}।"

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "छवि \"{url}\" सफलतापूर्वक संसाधित हुई।"

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "\"{url}\" थंबनेल बनाने में विफल: {info}।"

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
msgstr "इस सोशल मीडिया के लिए कार्ड बनाने के लिए पर्याप्त डेटा नहीं मिल सका।"

#: lib/card_box.rb:40
msgid "Twitter: No card found."
msgstr "Twitter: कोई कार्ड नहीं मिला।"

#: lib/card_box.rb:112
msgid "Card Error"
msgstr "कार्ड त्रुटि"

#: lib/data.rb:63
#, python-brace-format
