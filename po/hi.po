msgstr "\"{name}\" के लिए कोई घटना नहीं मिली!"

#: lib/data.rb:71
#, python-brace-format
msgid "Found a valid occurrence for \"{name}\" with value \"{value}\"."
msgstr "\"{name}\" के लिए \"{value}\" मान के साथ एक वैध घटना मिली।"

