msgid "Share Preview"
msgstr "Apercebut de partiment"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "« {name} » es void !"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "« {name} } » trobat."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr ""
"Impossible de trobar una metadonada pel títol. Utilizatz del títol del "
"document."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr ""
"Impossible de trobar lo títol del document. Utilizacion de l’adreça del site "
"a la plaça."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr ""
"Ajustatz una etiqueta « {tag} » a la pagina per aver mai de contraròtle sul "
"contengut."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "La descripcion deu almens aver « {count} » caractèrs."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Impossible de trobar cap de carta valida."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr ""
"Impossible de trobar « {name} ». Pensatz de fornir una proprietat meta "
"« {name} »."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "Carta de tipe « {name} » trobada."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Impossible de trobar cap de títol o descripcion valida."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "Impossible de trobar un imatge valid dins las metadonadas."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr ""
"Impossible de trobar un imatge valid dins las metadonadas o dins lo còs del "
"document."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr ""
"Impossible de trobar un imatge valid dins las metadonadas, se mostrarà una "
"icòna."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"Impossible de trobar un imatge valid dins las metadonadas, se mostrarà una "
"carta « {name} » amb una icòna."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "L’imatge « {url} » es definida amb una url relativa."

