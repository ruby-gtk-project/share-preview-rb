msgid "Share Preview"
msgstr "Share Preview"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" trống!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "Đã tìm thấy \"{name}\"."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr ""
"Không thể tìm thấy metadata cho tiêu đề!. Quay trở lại tiêu đề tài liệu."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "Không thể tìm thấy tiêu đề tài liệu!. Quay trở lại url trang web."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr "Thêm thẻ \"{tag}\" vào trang để kiểm soát nội dung."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "Mô tả phải dài ít nhất \"{count}\" ký tự."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Không thể tìm thấy bất kỳ loại thẻ hợp lệ."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr ""
"Không thể tìm thấy \"{name}\". Hãy cân nhắc việc cung cấp thuộc tính meta "
"\"{name}\"."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "Đã tìm thấy thẻ thuộc loại \"{name}\"."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Không thể tìm thấy bất kỳ tiêu đề hoặc mô tả hợp lệ nào."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "Không thể tìm thấy hình ảnh hợp lệ trong metadata."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr ""
"Không thể tìm thấy hình ảnh hợp lệ trong metadata hoặc nội dung tài liệu."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr ""
"Không thể tìm thấy hình ảnh hợp lệ trong metadata, sẽ hiển thị một biểu "
"tượng."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"Không thể tìm thấy hình ảnh hợp lệ trong metadata, sẽ hiển thị thẻ \"{name}"
"\" có biểu tượng."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "Hình ảnh \"{url}\" được xác định bằng url tương đối."

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "Hình ảnh \"{url}\" đáp ứng yêu cầu."

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "Hình ảnh \"{url}\" không đáp ứng được yêu cầu: {info}."

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "Hình ảnh \"{url}\" được xử lý thành công."

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "Không thu nhỏ được \"{url}\": {info}."

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
msgstr ""
"Không thể tìm thấy đủ dữ liệu để tạo thẻ cho phương tiện truyền thông xã hội "
"này."

#: lib/card_box.rb:40
msgid "Twitter: No card found."
