#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "Paylaşım Ön İzle"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" boş!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "\"{name}\" bulundu."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr "Başlık için üst veri bulunamadı! Belge başlığına geri dönülüyor."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "Belge başlığı bulunamadı! Site URL'sine geri dönülüyor."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr ""
"İçerik üzerinde denetim sahibi olmak için sayfaya \"{tag}\" etiketi ekleyin."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "Açıklama en az \"{count}\" karakter uzunluğunda olmalıdır."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Geçerli bir kart türü bulunamadı."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr "\"{name}\" bulunamadı. \"{name}\" üst veri özelliği sağlamayı düşünün."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "\"{name}\" türünde bir kart bulundu."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Geçerli bir başlık veya açıklama bulunamadı."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "Üst verilerde geçerli bir resim bulunamadı."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr "Üst verilerde ya da belge gövdesinde geçerli bir resim bulunamadı."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr "Üst verilerde geçerli bir resim bulunamadı, bir simge oluşturacak."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"Üst verilerde geçerli bir resim bulunamadığında, simgeli bir \"{name}\" "
"kartı oluşturulur."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "\"{url}\" resmi göreli URL ile tanımlanmış."

