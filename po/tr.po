#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "Resim \"{url}\" başarıyla işlendi."

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "\"{url}\" için küçük resim oluşturulamadı: {info}."

