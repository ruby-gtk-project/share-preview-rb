#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "シェアプレビュー"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\"は空です！"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "\"{name}\"を発見しました。"

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr ""
"タイトルのメタデータが見つかりませんでした。ドキュメントタイトルに戻ります。"

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "ドキュメントのタイトルが見つかりません！ サイトURLに切り替えます。"

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr "\"{tag}\"タグをページに追加することで、コンテンツを管理できます。"

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "説明文は少なくとも\"{count}\"文字以上である必要があります。"

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "有効なカードの種類が見つかりません。"

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr ""
"\"{name}\"が見つかりません。\"{name}\"メタプロパティを提供することを検討して"
"ください。"

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "\"{name}\"タイプのカードが見つかりました。"

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "有効なタイトルまたは説明が見つかりません。"

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "メタデータ内に有効な画像が見つかりません。"

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr "メタデータまたはドキュメント本文内に有効な画像が見つかりませんでした。"

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr "メタデータに有効な画像が見つからなかったため、アイコンを表示します。"

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"メタデータ内に有効な画像が見つかりませんでした。そのため、アイコン付きの"
"\"{name}\"カードを表示します。"

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "画像\"{url}\"は相対パスで定義されています。"

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "画像\"{url}\"は要件を満たしています。"

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "画像\"{url}\" は要件を満たしていません：{info}。"

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "画像\"{url}\"の処理が正常に完了しました。"

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "\"{url}\"のサムネイル作成に失敗しました: {info}。"

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
msgstr ""
"このソーシャルメディアのカードを生成するための十分なデータが見つかりませんで"
"した。"

#: lib/card_box.rb:40
msgid "Twitter: No card found."
msgstr "Twitter: カードが見つかりませんでした。"

#: lib/card_box.rb:112
msgid "Card Error"
msgstr "カードエラー"

#: lib/data.rb:63
#, python-brace-format
msgid "No occurrences found for \"{name}\"!"
msgstr "\"{name}\"に関する一致する項目は見つかりませんでした！"

#: lib/data.rb:71
#, python-brace-format
msgid "Found a valid occurrence for \"{name}\" with value \"{value}\"."
msgstr ""
"\"{name}\"という有効なインスタンスを\"{value}\"という値で検出しました。"

