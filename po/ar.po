msgstr "أضِف وسم «{tag}» إلى الصفحة للتحكم في المحتوى."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "يجب أن يتكوَّن الوصف من «{count}» محرفًا على الأقل."

