msgstr "Грешка в заявката: {info}"

#: lib/image.rb:42
#, python-brace-format
msgid "Image Error: {info}"
msgstr "Грешка в изображението: {info}"

#: lib/image.rb:48
#, fuzzy, python-brace-format
msgid "Image is too tiny ({actual}), minimum dimensions are {min}"
msgstr "Изображението е твърде малко ({actual}), минималните размери са {max}"

#: lib/image.rb:59
#, python-brace-format
msgid "Image is too heavy ({actual}), max size is {max}"
msgstr "Изображението е твърде голямо ({actual}), максималният размер е {max}"

#: lib/image.rb:66
#, python-brace-format
msgid "Image is unsupported: {info}"
msgstr "Изображението не се поддържа: {info}"

#: lib/image.rb:68 lib/window.rb:38
msgid "Unexpected Error"
msgstr "Неочаквана грешка"

#: lib/image.rb:117
msgid "Format is unsupported"
msgstr "Форматът не се поддържа"

#: lib/log_dialog.rb:46
