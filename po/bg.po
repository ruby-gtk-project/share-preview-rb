#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "Споделяне на преглед"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "„{name}“ е празно!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "Намерено е „{name}“."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr ""
"Метаданни за заглавието на документа не са намерени! Връщане към заглавието "
"на документа."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr ""
"Заглавието на документа не е намерен! Връщане към адреса на страницата."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr ""
"Добавете етикет „{tag}“ към страницата, за да имате контрол върху "
"съдържанието."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "Дължината на описанието трябва да бъде най-малко „{count}“ знака."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Правилен тип карта не е намерена."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr "„{name}“ не е намерено. Предоставете „{name}“ мета свойство."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "Намерена е карта от тип „{name}“."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Правилно заглавие или описание не е намерено."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "Правилно изображение не е намерено в метаданните."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr ""
"Правилно изображение не е намерено в метаданните или в тялото на документа."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr ""
"Правилно изображение не е намерено в метаданните, ще се генерира иконка."

#: lib/card.rb:254
#, fuzzy, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"Правилно изображение не е намерено в метаданните, ще се генерира карта "
"„{име}“ с иконка."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "Изображението „{url}“ е дефинирано с относителен адрес."

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "Изображението „{url}“ отговаря на изискванията."

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "Изображението „{url}“ не отговаря на изискванията: {info}."

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "Изображението „{url}“ е обработено успещно."

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "Грешка в предварителен преглед „{url}“: {info}."

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
msgstr ""
"Не са намерени достатъчно данни, за да се генерира карта за тази социална "
"мрежа."

#: lib/card_box.rb:40
msgid "Twitter: No card found."
msgstr "Twitter: Няма намерена карта."

#: lib/card_box.rb:112
msgid "Card Error"
msgstr "Грешка в картата"

#: lib/data.rb:63
#, python-brace-format
msgid "No occurrences found for \"{name}\"!"
msgstr "Няма съвпадения за „{name}“!"

#: lib/data.rb:71
#, python-brace-format
msgid "Found a valid occurrence for \"{name}\" with value \"{value}\"."
msgstr "Намерено е правилно съвпадения за „{name}“ със стойност „{value}“."

#: lib/data_dialog.rb:61
msgid "Metadata"
msgstr "Метаданни"

#: lib/data_dialog.rb:62
msgid "Body Images"
msgstr "Изображения на тялото"

#: lib/data_dialog.rb:317
msgid "Nothing to Show"
msgstr "Нищо за показване"

#: lib/image.rb:32
#, python-brace-format
msgid "Image Url Error: {info}"
msgstr "Грешка в адреса на изображението: {info}"

#: lib/image.rb:34
#, python-brace-format
msgid "Image Data Url Error: {info}"
msgstr "Грешка в данните на адреса на изображението: {info}"

#: lib/image.rb:36
#, python-brace-format
