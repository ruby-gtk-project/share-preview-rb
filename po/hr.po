#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "Pregled dijeljenja"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "„{name}” je prazno!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "Pronađeno je „{name}”."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr "Metapodaci za naslov nisu pronađeni! Preuzima se naslov dokumenta."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "Naslov dokumenta nije pronađen! Preuzima se URL adresa web stranice."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr "Dodaj „{tag}” oznaku stranici za kontroliranje sadržaja."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "Opis treba sadržati baren „{count}” znaka(ova)."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Nijedna valjana vrsta kartice nije pronađena."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr "„{name}” nije pronađeno. Zadaj meta svojstvo „{name}”."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "Pronađena je „{name}” vrsta kartica."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Nijedan naslov niti opis nisu pronađeni."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "U metapodacima nije pronađena valjana slika."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr ""
"Neuspjelo pronalaženje valjane slike u metapodacima ili sadržaju dokumenta."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr ""
"U metapodacima nije pronađena nijedna valjana slika. Prikazat će se ikona."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"U metapodacima nije pronađena nijedna valjana slika. Prikazat će se „{name}” "
"kartica s ikonom."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "Slika „{url}” je definirana relativnim URL-om."

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "Slika „{url}” ispunjava uvjete."

