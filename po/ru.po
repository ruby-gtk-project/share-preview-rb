#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "Share Preview"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" пусто!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "Найдено \"{name}\"."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr ""
"Невозможно найти метаданные для заголовка! Используем заголовок документа."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr "Невозможно найти заголовок документа! Используем URL сайта."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr ""
"Добавьте к странице тег \"{tag}\", чтобы иметь возможность управлять "
"содержимым."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "Описание должно содержать не менее \"{count}\" символов."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Не удалось найти допустимый тип карточки."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr ""
"Не удалось найти \"{name}\". Рекомендуется указать мета-свойство \"{name}\"."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "Найдена карточка с типом \"{name}\"."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Не удалось найти допустимый заголовок или описание."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "Не удалось найти допустимое изображение в метаданных."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr "Не удалось найти допустимое изображение в метаданных или теле."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr ""
"Не удалось найти допустимое изображение в метаданных, вместо него будет "
"показан значок."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"Не удалось найти допустимое изображение в метаданных, вместо него будет "
"отображена карточка \"{name}\" со значком."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "Изображение \"{url}\" задано допустимым URL."

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "Изображение \"{url}\" соответствует требованиям."

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "Изображение \"{url}\" не соответствует требованиям: {info}."

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "Изображение \"{url}\" успешно обработано."

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "Ошибка создания миниатюры для \"{url}\": {info}."

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
msgstr ""
"Не удалось найти достаточно данных, чтобы сгенерировать карточку для этой "
"социальной сети."

#: lib/card_box.rb:40
msgid "Twitter: No card found."
msgstr "Twitter: Карточка не найдена."

#: lib/card_box.rb:112
msgid "Card Error"
msgstr "Ошибка карточки"

#: lib/data.rb:63
#, python-brace-format
msgid "No occurrences found for \"{name}\"!"
msgstr "Не найдено вхождений для \"{name}\"!"

#: lib/data.rb:71
#, python-brace-format
msgid "Found a valid occurrence for \"{name}\" with value \"{value}\"."
msgstr "Найдено допустимое для \"{name}\" значение \"{value}\"."

