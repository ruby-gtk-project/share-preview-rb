#: lib/about_dialog.rb:13 lib/main.rb:22 lib/window.rb:379
msgid "Share Preview"
msgstr "Share Preview"

#: lib/card.rb:127 lib/data.rb:65
#, python-brace-format
msgid "\"{name}\" is empty!"
msgstr "\"{name}\" on tyhjä!"

#: lib/card.rb:130
#, python-brace-format
msgid "Found \"{name}\"."
msgstr "Löytyi \"{name}\"."

#: lib/card.rb:140 lib/card.rb:143
msgid "Unable to find a metadata for title!. Falling back to document title."
msgstr ""
"Metatietoja otsikkoa varten ei löytynyt! Turvaudutaan asiakirjan otsikkoon."

#: lib/card.rb:144
msgid "Unable to find the document title!. Falling back to site url."
msgstr ""
"Asiakirjan otsikkoa ei löytynyt! Turvaudutaan sivun verkko-osoitteeseen."

#: lib/card.rb:161
#, python-brace-format
msgid "Add a \"{tag}\" tag to the page to have control over the content."
msgstr "Lisää tagi \"{tag}\" sivulle hallitaksesi sisältöä."

#: lib/card.rb:168
#, python-brace-format
msgid "The description should be at least \"{count}\" characters long."
msgstr "Kuvauksen tulee olla enintään \"{count}\" merkkiä."

#: lib/card.rb:185
msgid "Unable to find any valid card type."
msgstr "Mitään kelvollista korttityyppiä ei löytynyt."

#: lib/card.rb:201
#, python-brace-format
msgid ""
"Unable to find \"{name}\". Consider providing a \"{name}\" meta property."
msgstr ""
"\"{name}\":ta ei voi löytää. Harkitse meta-omaisuuden \"{name}\" "
"tiedottamista."

#: lib/card.rb:209
#, python-brace-format
msgid "Found card of type \"{name}\"."
msgstr "Kortti tyyppiä \"{name}\" löytyi."

#: lib/card.rb:217
msgid "Unable to find any valid title or description."
msgstr "Mitään kelvollista otsikkoa tai kuvausta ei löytynyt."

#: lib/card.rb:246
msgid "Unable to find a valid image in the metadata."
msgstr "Metatiedoista ei löytynyt kelvollista kuvaa."

#: lib/card.rb:248
msgid "Unable to find a valid image in the metadata or document body."
msgstr "Metatiedoista tai asiakirjan rungosta ei löytynyt kelvollista kuvaa."

#: lib/card.rb:250
msgid "Unable to find a valid image in the metadata, will render an icon."
msgstr "Metatiedoista ei löytynyt kelvollista kuvaa, piirretään kuvake."

#: lib/card.rb:254
#, python-brace-format
msgid ""
"Unable to find a valid image in the metadata, will render a \"{name}\" card "
"with icon."
msgstr ""
"Metatiedoista kelvollista kuvaa ei voi löytää; hahmonnetaan kortti \"{name}"
"\", jossa on kuvake."

#: lib/card.rb:324
#, python-brace-format
msgid "Image \"{url}\" is defined with a relative url."
msgstr "Kuva \"{url}\" on määritetty suhteellisella verkko-osoitteella."

#: lib/card.rb:336
#, python-brace-format
msgid "Image \"{url}\" met the requirements."
msgstr "Kuva \"{url}\" täytti vaatimukset."

#: lib/card.rb:360
#, python-brace-format
msgid "Image \"{url}\" did not meet the requirements: {info}."
msgstr "Kuva \"{url}\" ei täyttänyt vaatimuksia: {info}."

#: lib/card.rb:406
#, python-brace-format
msgid "Image \"{url}\" processed successfully."
msgstr "Kuva \"{url}\" käsitelty."

#: lib/card.rb:413
#, python-brace-format
msgid "Failed to thumbnail \"{url}\": {info}."
msgstr "Pikkukuvan \"{url}\" luominen epäonnistui: {info}."

#: lib/card_box.rb:39
msgid "Couldn’t find enough data to generate a card for this social media."
msgstr "Ei riittävästi dataa kortin luomiseksi tätä sosiaalista mediaa varten."

